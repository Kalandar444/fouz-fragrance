# ==============================================================================
# Fouz Fragrance - Production Environment Variables Example
# ==============================================================================

SECRET_KEY=replace-with-a-strong-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=fouzfragrance.ae,www.fouzfragrance.ae,api.fouzfragrance.ae

# PostgreSQL Production Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fouz_db
DB_USER=fouz_user
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://fouzfragrance.ae,https://www.fouzfragrance.ae

# SMTP Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_smtp_username@gmail.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
DEFAULT_FROM_EMAIL="Fouz Fragrance <noreply@fouzfragrance.ae>"
BUSINESS_CONTACT_EMAIL=fouzfragranceae@gmail.com

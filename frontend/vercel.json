{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://fouz-fragrance-backend.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://fouz-fragrance-backend.onrender.com/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
